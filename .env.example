# Urban Threads v2 Environment Configuration
PORT=your_value_here

# Session Encryption Key
SESSION_SECRET=your_value_here

# Stripe API Keys (Replace with your actual keys from Stripe Dashboard)
STRIPE_SECRET_KEY=your_value_here
STRIPE_PUBLISHABLE_KEY=your_value_here

# SMTP Email Configuration (e.g. Mailtrap, SendGrid, Resend)
SMTP_HOST=your_value_here
SMTP_PORT=your_value_here
SMTP_USER=your_value_here
SMTP_PASS=your_value_here
FROM_EMAIL=your_value_here
